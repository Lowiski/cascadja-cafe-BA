# Neon Postgres connection string (copy this file to .env and paste your own)
# Neon dashboard -> your project -> Connect -> copy the "psql" / connection string.
# It looks like:
# postgresql://neondb_owner:XXXXXXXX@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# API port
PORT=4000

# Frontend origin allowed to call the API (Vite dev server)
CLIENT_URL=http://localhost:5173

# After setting DATABASE_URL, run `npm run db:setup` from the repo root
# to create the active menu_items / addons / sales_fact tables and seed them.
# Without it the app runs on deterministic sample data based on the real menu.

# Admin login (change these before deploying; defaults are for local capstone use)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cascadja2026

# Long random string used to sign admin session tokens
AUTH_SECRET=replace-with-a-long-random-string
